      "SpaceBefore": 6,
      "SpaceAfter": 6,
      "LineSpacingRule": "Exactly",
      "LineSpacing": 11
    },
    "Table": {
      "NumberWidth": 24
    },
    "TableCaption": {
      "FontName": "游ゴシック",
      "Size": 10,
      "Bold": true,
      "Color": 0,
      "Alignment": "left",
      "SpaceBefore": 6,
      "SpaceAfter": 3,
      "KeepWithNext": true,
      "LineSpacingRule": "Exactly"
