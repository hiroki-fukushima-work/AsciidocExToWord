    "Heading1": {
      "FontName": "游ゴシック",
      "FontSize": 16,
      "Bold": true,
      "Color": 0,
      "Alignment": "Left",
      "KeepWithNext": true,
      "LineSpacingRule": "Exactly",
      "LineSpacing": 12
    },
    "Heading2": {
      "FontName": "游ゴシック",
      "FontSize": 14,
      "Bold": true,
      "Color": 0,
      "Alignment": "Left",
      "KeepWithNext": true,
      "LineSpacingRule": "Exactly",
      "LineSpacing": 12
    },
    "Heading3": {
      "FontName": "游ゴシック",
      "FontSize": 12,
      "Bold": true,
      "Color": 0,
      "Alignment": "Left",
      "KeepWithNext": true,
      "LineSpacingRule": "Exactly",
      "LineSpacing": 12
