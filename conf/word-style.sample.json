    },
    "TableBody": {
      "FontName": "游ゴシック",
      "Size": 10,
      "Bold": false,
      "Color": 0,
      "LineSpacingRule": "Exactly"
    },
    "FigureCaption": {
      "FontName": "游ゴシック",
      "Size": 10,
      "Bold": true,
      "Color": 0,
      "Alignment": "center",
      "SpaceBefore": 6,
      "SpaceAfter": 3,
