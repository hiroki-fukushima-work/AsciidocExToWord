        "Important": "❗重要: ",
        "Warning": "⚠ 警告: ",
        "Caution": "⚠ 注意: ",
        "Note": "📝注記: ",
        "Tip": "💡ヒント: "
      },
      "Colors": {
        "Important": "FFE699",
        "Warning": "FFF2CC",
        "Caution": "FFF2CC",
        "Note": "D9E1F2",
        "Tip": "E2EFDA"
      }
    },
    "CodeCaption": {
      "FontName": "游ゴシック",
      "Size": 10,
      "Bold": true,
      "Color": 0,
      "Alignment": "center",
      "SpaceBefore": 6,
      "SpaceAfter": 3,
      "KeepWithNext": true,
      "LineSpacingRule": "Exactly"
    },
    "Code": {
      "FontName": "Cascadia Code",
      "Size": 9,
      "Bold": false,
      "Color": 0,
      "BackgroundColor": "F3F3F3",
