{
  "Document": {
    "PageSetup": {
      "TopMarginMm": 25,
      "BottomMarginMm": 20,
      "LeftMarginMm": 25,
      "RightMarginMm": 20
    }
  },
  "CoverPage": {
    "Mode": "Template",
    "TemplatePath": ".\\template\\cover-template.docx"
  },
  "HeaderFooter": {
    "Header": {
      "Text": "{title}  {revnumber}",
      "Style": {
        "FontName": "游ゴシック",
        "Size": 9,
        "Bold": false,
        "Italic": false,
        "Alignment": "right",
        "SpaceAfter": 0,
        "LineSpacingRule": "Exactly",
        "LineSpacing": 9
      }
    },
    "Footer": {
      "Text": "{copyright}",
      "Style": {
        "FontName": "游ゴシック",
        "Size": 8,
        "Bold": false,
        "Italic": false,
        "Alignment": "center",
        "SpaceBefore": 0,
        "LineSpacingRule": "Exactly",
        "LineSpacing": 8
      }
    }
  },
  "PlantUml": {
    "Enabled": true,
    "JavaPath": "java",
    "JarPath": ".\\lib\\plantuml-1.2025.4.jar",
    "OutputDir": ".\\generated-images",
    "DefaultFormat": "svg"
  },
  "DrawIo": {
    "Enabled": true,
    "CliPath": "C:\\Program Files\\draw.io\\draw.io.exe",
    "OutputDir": ".\\generated-images",
    "DefaultFormat": "png"
  },
  "Image": {
    "MaxWidthMm": 160
  },
  "Styles": {
    "Title": {
      "FontName": "游ゴシック",
      "Size": 20,
      "Bold": true,
      "Color": 0,
      "Alignment": "center",
      "SpaceAfter": 12,
      "LineSpacingRule": "Exactly",
      "LineSpacing": 12
    },
    "Subtitle": {
      "FontName": "游ゴシック",
      "Size": 12,
      "Bold": false,
      "Color": 0,
      "Alignment": "center",
      "SpaceAfter": 12,
      "LineSpacingRule": "Exactly",
      "LineSpacing": 12
    },
    "Owner": {
      "FontName": "游ゴシック",
      "Size": 10,
      "Bold": false,
      "Color": 0,
      "Alignment": "right",
      "SpaceAfter": 6,
      "LineSpacingRule": "Exactly",
      "LineSpacing": 10 
    },
    "Revision": {
      "FontName": "游ゴシック",
      "Size": 10,
      "Bold": false,
      "Color": 0,
      "Alignment": "right",
      "SpaceAfter": 3,
      "LineSpacingRule": "Exactly",
      "LineSpacing": 10
    },
    "Copyright": {
      "FontName": "游ゴシック",
      "Size": 9,
      "Bold": false,
      "Color": 0,
      "Alignment": "center",
      "SpaceAfter": 12,
      "LineSpacingRule": "Exactly",
      "LineSpacing": 9
