      "LineSpacing": 11
    },
    "Body": {
      "FontName": "游ゴシック",
      "Size": 10.5,
      "Bold": false,
      "Color": 0,
      "SpaceAfter": 4,
      "WidowControl": false,
      "LineSpacingRule": "Exactly",
      "LineSpacing": 11
